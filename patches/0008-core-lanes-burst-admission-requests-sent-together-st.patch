diff --git a/zig/src/core/lane_host_admit.zig b/zig/src/core/lane_host_admit.zig
index 09b3e6bd..30fc9e1f 100644
--- a/zig/src/core/lane_host_admit.zig
+++ b/zig/src/core/lane_host_admit.zig
@@ -3,6 +3,67 @@ const api = @import("engine_api.zig");
 const LaneHost = @import("lane_host.zig").LaneHost;
 const Job = LaneHost.Job;
 const lanes = @import("lanes");
+const std = @import("std");
+
+/// TENSORFOLD_ADMIT_WAIT_MS (5; 0 off): an idle engine holds a first arrival this long for requests sent with it, then
+/// admits them as one burst whose prompts all fill before the first round. Identical requests then decode in lockstep
+/// and share each round's work (the zig-flashnext engine's burst admission, 3 ms there); one request alone waits at
+/// most this. GB10, Flash-Next, 4 identical greedy streams: code 165 -> 236 tok/s, chat 119 -> 166 (10-25).
+pub fn waitMs() u32 {
+    if (wait_ms) |w| return w;
+    const w: u32 = if (std.c.getenv("TENSORFOLD_ADMIT_WAIT_MS")) |v| std.fmt.parseInt(u32, std.mem.span(v), 10) catch 5 else 5;
+    wait_ms = @min(w, 1000);
+    return wait_ms.?;
+}
+var wait_ms: ?u32 = null;
+
+/// An idle engine with a request queued inside the admit window: waits for more until the window ends (or every lane
+/// is asked for). True when it waited (the caller goes round again), false to admit now.
+pub fn holdBurst(h: *LaneHost) bool {
+    const ms = waitMs();
+    if (ms == 0) return false;
+    h.lock();
+    defer h.unlock();
+    if (h.closing or h.core.activeCount() != 0 or h.admitted.items.len != 0 or h.filling.items.len != 0) return false;
+    const n = h.queued.items.len;
+    if (n == 0 or n >= @min(h.info_.lanes, h.memory_lanes orelse h.info_.lanes)) return false;
+    const now = std.Io.Clock.awake.now(h.io).toNanoseconds();
+    const due = h.queued.items[0].submitted + @as(i96, ms) * std.time.ns_per_ms;
+    if (now >= due) return false;
+    h.wake.waitTimeout(h.io, &h.mutex, .{ .duration = .{ .raw = .fromNanoseconds(@intCast(due - now)), .clock = .awake } }) catch {};
+    return true;
+}
+
+/// With the admit window on and an idle engine: every queued request a lane is free for, admitted before any starts
+/// (so none takes the lone driver) and marked a burst; false when fewer than two wait (the usual path then).
+pub fn burst(h: *LaneHost) bool {
+    if (waitMs() == 0) return false;
+    {
+        h.lock();
+        defer h.unlock();
+        if (h.core.activeCount() != 0 or h.admitted.items.len != 0 or h.filling.items.len != 0 or h.queued.items.len < 2) return false;
+    }
+    var jobs: [lanes.Engine.max_together]*Job = undefined;
+    var n: usize = 0;
+    var took = false;
+    while (n < jobs.len) {
+        switch (h.takeJob()) {
+            .none => break,
+            .failed => took = true,
+            .job => |j| {
+                jobs[n] = j;
+                n += 1;
+            },
+        }
+    }
+    for (jobs[0..n]) |job| {
+        took = true;
+        job.burst = true;
+        const at = h.setup(job) orelse continue;
+        _ = h.launch(job, at);
+    }
+    return took;
+}
 
 /// The queued job to admit (its index), or null to hold; the caller holds the lock and a lane is free.
 pub fn pick(h: *LaneHost) ?usize {
