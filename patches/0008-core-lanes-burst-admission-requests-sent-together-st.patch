@@ -363,7 +364,21 @@ pub const LaneHost = struct {
     /// The next filling job's next prompt chunk: the other streams' rounds run between chunks, not after the prompt.
     fn fillOne(h: *LaneHost) void {
         if (h.filling.items.len == 0) return;
-        const at = fill.next(h);
+        h.fillAt(fill.next(h));
+    }
+
+    /// A burst's prompts (admit.burst) all go in before the next round, so its streams start in lockstep.
+    fn fillBurst(h: *LaneHost) void {
+        while (true) {
+            const at = for (h.filling.items, 0..) |j, i| {
+                if (j.burst) break i;
+            } else return;
+            h.fillAt(at);
+        }
+    }
+
+    /// Filling job `at`'s next prompt chunk; done, it is prefilled and delivered.
+    fn fillAt(h: *LaneHost, at: usize) void {
         const job = h.filling.items[at];
         const first = !job.fill_began;
         job.fill_began = true;
@@ -528,8 +543,10 @@ pub const LaneHost = struct {
             rows_host.answer(h);
