+// TF_FLASHNEXT_KV=fp8 (the zig-flashnext engine's kv8.py): a (position, KV head) key row is HD e4m3 codes, then s_k,
+// s_v (fp32) and 8 zero bytes; a value row is HD codes. Each scale is 2^(ceil(log2 amax) - 8) of its bf16 row.
+constexpr int KV8_KEY = HD + 16;  // bytes a key row takes
+
+// A block's max |v| (every thread takes part): each warp's butterfly, then the warps' maxima.
+__device__ __forceinline__ float block_amax(float v, float* scratch) {
+    v = fabsf(v);
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) v = fmaxf(v, __shfl_xor_sync(0xffffffffu, v, o));
+    if ((threadIdx.x & 31) == 0) scratch[threadIdx.x >> 5] = v;
+    __syncthreads();
+    float m = 0.0f;
+    for (int w = 0; w < static_cast<int>(blockDim.x >> 5); ++w) m = fmaxf(m, scratch[w]);
+    __syncthreads();
+    return m;
+}
+
+// kv8.scale_of: amax -> 2^(ceil(log2 amax) - 8) and its exact reciprocal, the biased exponent held within 1 .. 254
+__device__ __forceinline__ float kv8_scale(float amax, float& inv) {
+    const int bits = __float_as_int(amax);
+    int e = ((bits >> 23) & 0xFF) + ((bits & 0x7FFFFF) != 0);
+    e = min(max(e - 8, 1), 254);
+    inv = __int_as_float((254 - e) << 23);
+    return __int_as_float(e << 23);
+}
+
+// 8 codes times their row's scale as 8 bf16 (exact: an e4m3 value times a power of two is a bf16 value)
+__device__ __forceinline__ uint4 kv8_widen(uint2 c, float sc) {
+    uint4 out;
+    uint32_t* o = reinterpret_cast<uint32_t*>(&out);
+    const uint32_t w[2] = {c.x, c.y};
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const __nv_fp8x2_storage_t pair = static_cast<__nv_fp8x2_storage_t>((w[i >> 1] >> (16 * (i & 1))) & 0xFFFF);
+        const float2 f = __half22float2(__half2(__nv_cvt_fp8x2_to_halfraw2(pair, __NV_E4M3)));
+        const __nv_bfloat162 b = __floats2bfloat162_rn(__fmul_rn(f.x, sc), __fmul_rn(f.y, sc));
+        o[i] = *reinterpret_cast<const uint32_t*>(&b);
+    }
+    return out;
+}
+
 }  // namespace fn_attn
 
