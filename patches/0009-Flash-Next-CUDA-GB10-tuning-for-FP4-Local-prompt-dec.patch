diff --git a/zig/src/families/flashnext/cuda_window_graph.zig b/zig/src/families/flashnext/cuda_window_graph.zig
new file mode 100644
index 00000000..d82240a1
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_window_graph.zig
@@ -0,0 +1,205 @@
+//! Drafted windows' passes and the draft head's pieces as CUDA graphs on one GPU (TF_FLASHNEXT_WINDOW_GRAPH=0: eager):
+//! a pass's ids, positions and n-gram rows are staged outside the graph (Pass.stageWindow, Pass.stage), the kernels
+//! captured once a key and replayed after. A key holds every host value a launch takes: rows, the attention geometry
+//! the rows' end sets, the caches' and the draft's buffers (the DeltaNet state's parity included), scratch and model.
+//! Keys carry the sequence's or the draft's generation; the caches are cleared on scratch and score reallocation.
+const std = @import("std");
+const cuda = @import("cuda");
+const batch = @import("cuda_batch.zig");
+const wt = @import("cuda_prompt_wt.zig");
+
+/// Graphs a cache holds at most; past it the cache starts over. Finished sequences' graphs stay until then (their
+/// generation never comes again), so this bounds their memory: 256 held cost ~4 GB of MemAvailable at the quick (10-25).
+const max_graphs = 128;
+
+var gens = std.atomic.Value(u64).init(1);
+
+/// A sequence's or a draft's own number for the keys: a freed one's graphs never match a new one at its addresses,
+/// so a new sequence leaves the others' graphs in place.
+pub fn nextGen() u64 {
+    return gens.fetchAdd(1, .monotonic);
+}
+
+pub fn enabled() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_WINDOW_GRAPH") orelse return true;
+    return !std.mem.eql(u8, std.mem.span(v), "0");
+}
+
+/// attnRows' host values for `rows` rows (one attention block) ending at `ends` in a `cap`-token cache: the dense
+/// chunks, and the score grid at 64 blocks a CTA (0: no score launch).
+pub const Geometry = struct {
+    chunks: u32,
+    score_grid: u32,
+
+    pub fn at(ends: usize, cap: usize) Geometry {
+        const ratio = wt.index_ratio;
+        const nb = batch.scoreStride(cap);
+        const scored = ends / ratio > wt.index_top;
+        return .{
+            .chunks = @intCast((@min(ends, wt.dense_keys) + 511) / 512),
+            .score_grid = if (scored) @intCast((@min(nb, (ends + ratio - 1) / ratio) + 63) / 64) else 0,
+        };
+    }
+};
+
+/// A verify window's pass (Engine.forward).
+pub const Key = struct {
+    gen: u64,
+    rows: u32,
+    geometry: Geometry,
+    cap: u64,
+    kc: u64,
+    state: u64,
+    scratch: u64,
+    scratch_cap: u64,
+    scores: u64,
+    model: u64,
+    /// the hooks' buffers: scores out, streams, and every pointer of the window's keep
+    hooks: u64,
+
+    pub fn init(seq: anytype, pos0: usize, rows: usize, s: *const batch.Scratch, scores: u64, model: u64, hooks: batch.Hooks) Key {
+        var h = std.hash.Wyhash.init(0);
+        h.update(std.mem.asBytes(&hooks.logits_out));
+        h.update(std.mem.asBytes(&hooks.streams));
+        if (hooks.keep) |k| h.update(std.mem.asBytes(k));
+        return .{
+            .gen = seq.gen,
+            .rows = @intCast(rows),
+            .geometry = .at(pos0 + rows, seq.cap),
+            .cap = seq.cap,
+            .kc = seq.kc[0].ptr,
+            .state = seq.state[0].ptr,
+            .scratch = s.h,
+            .scratch_cap = s.cap,
+            .scores = scores,
+            .model = model,
+            .hooks = h.final(),
+        };
+    }
+};
+
+/// One piece of the draft head's pass (forwardHead): its rows, where its input rows come from, whether it scores.
+pub const HeadKey = struct {
+    gen: u64,
+    rows: u32,
+    geometry: Geometry,
+    scores: bool,
+    cap: u64,
+    kc: u64,
+    input: u64,
+    out: u64,
+    dlogits: u64,
+    scratch: u64,
+    scratch_cap: u64,
+    score_rows: u64,
+};
+
+/// Several streams' drafted windows in one pass (Engine.windows): each lane's caches, state parity, rows, geometry,
+/// keeps and outputs hashed in lane order, with the pass's scratch, scores and model.
+pub const SharedKey = struct {
+    lanes: u32,
+    rows: u32,
+    scratch: u64,
+    scratch_cap: u64,
+    scores: u64,
+    model: u64,
+    out: u64,
+    each: u64,
+
+    pub fn init(lanes: []const batch.Lane, s: *const batch.Scratch, scores: u64, model: u64, out: u64) SharedKey {
+        var h = std.hash.Wyhash.init(0);
+        var rows: usize = 0;
+        for (lanes) |l| {
+            const g: Geometry = .at(l.pos + l.rows, l.seq.cap);
+            for ([_]u64{ l.seq.gen, l.seq.kc[0].ptr, l.seq.state[0].ptr, l.seq.cap, l.rows, g.chunks, g.score_grid, l.streams, l.logits }) |v| h.update(std.mem.asBytes(&v));
+            if (l.keep) |k| h.update(std.mem.asBytes(k));
+            rows += l.rows;
+        }
+        return .{ .lanes = @intCast(lanes.len), .rows = @intCast(rows), .scratch = s.h, .scratch_cap = s.cap, .scores = scores, .model = model, .out = out, .each = h.final() };
+    }
+};
+
+/// One group of streams' draft-head pieces in one pass (Ops.headGroup): each lane's draft buffers, rows, input rows
+/// and geometry hashed in lane order, with whether it scores, scratch and the block scores.
+pub const HeadManyKey = struct {
+    lanes: u32,
+    rows: u32,
+    scores: bool,
+    scratch: u64,
+    scratch_cap: u64,
+    score_rows: u64,
+    each: u64,
+};
+
+/// A partial keep's replay of the kept rows over the DeltaNet layers (Ops.rollback): the rows kept, scratch, and a
+/// hash of every buffer pointer it reads or writes (the sequence's conv windows, states and tail, the draft's keeps).
+pub const RollbackKey = struct {
+    keep: u32,
+    scratch: u64,
+    scratch_cap: u64,
+    bufs: u64,
+};
+
+pub fn Cache(comptime K: type) type {
+    return struct {
+        const Self = @This();
+        map: std.AutoHashMapUnmanaged(K, cuda.graph.Exec) = .empty,
+        /// Keys run once, eagerly: a key is captured the second time it comes (most of a stream's keys repeat, a
+        /// capture costs a few passes, and a one-off key would never pay it back).
+        seen: std.AutoHashMapUnmanaged(K, void) = .empty,
+        captures: u64 = 0,
+        replays: u64 = 0,
+        /// A capture failed: every later pass runs eagerly (logged once).
+        off: bool = false,
+
+        pub fn clear(c: *Self, gpa: std.mem.Allocator) void {
+            var it = c.map.valueIterator();
+            while (it.next()) |e| e.deinit();
+            c.map.clearAndFree(gpa);
+            c.seen.clearAndFree(gpa);
+        }
+
+        /// `pass.run()` (kernels only: its uploads already queued) as `key`'s graph, captured first when new.
+        pub fn run(c: *Self, gpa: std.mem.Allocator, stream: cuda.Stream, key: K, pass: anytype) !void {
+            if (c.off) return pass.run();
+            if (c.map.get(key)) |exec| {
+                c.replays += 1;
+                return exec.launchOn(stream);
+            }
+            if (c.map.count() >= max_graphs or c.seen.count() >= 4 * max_graphs) c.clear(gpa);
+            if (!c.seen.contains(key)) {
+                try c.seen.put(gpa, key, {});
+                return pass.run();
+            }
+            var exec = capture(stream, pass) catch |err| {
+                // the stream is out of capture again: this pass eagerly, and the ones after it
+                std.log.warn("{s} graphs off: capture failed ({s}), eager from here", .{ @typeName(K), @errorName(err) });
+                c.off = true;
+                return pass.run();
+            };
+            errdefer exec.deinit();
+            try c.map.put(gpa, key, exec);
+            c.captures += 1;
+            if (c.captures % 64 == 1) std.log.info("{s} graphs: {d} captured, {d} replayed, {d} held", .{ @typeName(K), c.captures, c.replays, c.map.count() });
+            try exec.launchOn(stream);
+        }
+    };
+}
+
+/// The pass's kernels captured and instantiated (uploaded to the device), nothing launched; the stream left uncaptured.
+fn capture(stream: cuda.Stream, pass: anytype) !cuda.graph.Exec {
+    try cuda.graph.beginCapture(stream, .thread_local);
+    pass.run() catch |err| {
+        if (cuda.graph.endCapture(stream)) |g| {
+            var discarded = g;
+            discarded.deinit();
+        } else |_| {}
+        return err;
+    };
+    var graph = try cuda.graph.endCapture(stream);
+    defer graph.deinit();
+    var exec = try graph.instantiate();
+    errdefer exec.deinit();
+    try exec.upload(stream);
+    return exec;
+}
