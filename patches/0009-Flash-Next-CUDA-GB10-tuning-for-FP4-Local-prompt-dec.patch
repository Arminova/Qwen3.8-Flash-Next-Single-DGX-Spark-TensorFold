+#pragma unroll
+                for (int i = 0; i < T::MT; ++i) mma(acc[i][j], a[i], v.x, v.y);
+            }
+        }
+    }
+    wait<0>();
+    if (SK > 1) {
+#pragma unroll
+        for (int i = 0; i < T::MT; ++i)
+#pragma unroll
+            for (int j = 0; j < T::NT; ++j)
+#pragma unroll
+                for (int e = 0; e < 4; ++e) acc[i][j][e] = tot[i][j][e] + acc[i][j][e];
+    }
