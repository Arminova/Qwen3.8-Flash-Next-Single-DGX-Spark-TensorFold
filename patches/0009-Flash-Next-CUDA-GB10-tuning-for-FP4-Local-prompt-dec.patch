diff --git a/zig/src/families/flashnext/cuda_lanes_costs.zig b/zig/src/families/flashnext/cuda_lanes_costs.zig
new file mode 100644
index 00000000..8cdc82d8
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_lanes_costs.zig
@@ -0,0 +1,141 @@
+//! This GPU's costs for the core's draft allocation, measured at load (TF_FLASHNEXT_COSTS=1; the zig-flashnext engine's
+//! measure): a drafted window of 1..depth+1 rows (its pass and draws), one chained head level, and shared rounds of
+//! 2 and 4 streams' full windows, each the median of 5 after a warm one. Without them (the default) the core grants
+//! every offered draft.
+const std = @import("std");
+const core = @import("core");
+const mtp = @import("cuda_mtp.zig");
+
+pub fn on() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_COSTS") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+const reps = 5;
+/// Rows a decode-shaped kernel's tile holds (qmmf.bucket's 16): a cost regime for Costs.measured.
+const regime = 16;
+
+fn now(io: std.Io) i96 {
+    return std.Io.Clock.awake.now(io).toNanoseconds();
+}
+
+fn median(xs: []f64) f64 {
+    std.mem.sort(f64, xs, {}, std.sort.asc(f64));
+    return xs[xs.len / 2];
+}
+
+/// One measuring stream: its caches, its draft, and the token ids its positions take.
+const Probe = struct {
+    seq: @import("cuda_prompt.zig").Seq,
+    d: mtp.Draft,
+
+    fn deinit(p: *Probe, gpa: std.mem.Allocator) void {
+        p.d.deinit();
+        p.seq.deinit(gpa);
+    }
+};
+
+/// Fills self's costs (facts' window_costs, mtp_step_ms, shared_costs) on a fresh stream; no live stream exists yet.
+pub fn measure(self: anytype, io: std.Io) !void {
+    const e = self.engine;
+    const head = self.head orelse return;
+    const gpa = self.gpa;
+    const ops = self.ops();
+    // the gather reads the n-gram table from RAM, as in serving once warm
+    e.ngram.waitWarm();
+    const top: usize = @min(self.depth + 1, mtp.max_rows);
+    const lead = mtp.max_rows + 3;
+    var ids: [lead + 256]u32 = undefined;
+    for (&ids, 0..) |*t, i| t.* = @intCast(1000 + (i * 7919) % 60000);
+    const cap = ids.len + mtp.max_rows;
+    const t_all = now(io);
+
+    var probes: [4]Probe = undefined;
+    var made: usize = 0;
+    defer for (probes[0..made]) |*p| p.deinit(gpa);
+    while (made < 4) {
+        var seq = try e.newSeq(cap);
+        errdefer seq.deinit(gpa);
+        var d = try mtp.Draft.init(gpa, e.driver, self.stream, cap, head.ids.len, e.chunk);
+        errdefer d.deinit();
+        try ops.prefill(&seq, &d, ids[0..lead]);
+        probes[made] = .{ .seq = seq, .d = d };
+        made += 1;
+    }
+    var out: [mtp.max_rows]u32 = undefined;
+
+    // a lone window of w rows: its pass and its draws (the sync), then one row kept
+    const one = &probes[0];
+    var times: [reps + 1]f64 = undefined;
+    var verify: [mtp.max_rows + 1]f64 = @splat(0);
+    for (0..32) |_| _ = try window(ops, e, io, one, &ids, 1, &out);
+    for (1..top + 1) |w| {
+        for (&times) |*x| x.* = try window(ops, e, io, one, &ids, w, &out);
+        verify[w] = median(times[1..]);
+    }
+    // a chained head level: one draft against `deep`, kept rows absorbed first in both
+    var chain: [2]f64 = undefined;
+    const deep = @max(2, @min(8, top - 1));
+    for ([_]usize{ 1, deep }, &chain) |levels, *slot| {
+        for (&times) |*x| {
+            _ = try window(ops, e, io, one, &ids, 1, &out);
+            try e.complete();
+            const t0 = now(io);
+            var c: mtp.Chain = .{};
+            try ops.draft(&one.d, out[0..1], one.d.streams.ptr, one.seq.fed + 1, levels, null, 0, &c);
+            try e.complete();
+            x.* = @as(f64, @floatFromInt(now(io) - t0)) / 1e6;
+        }
+        slot.* = median(times[1..]);
+    }
+    const k = core.draft_depth.Costs.measured(verify[0 .. top + 1], (chain[1] - chain[0]) / @as(f64, @floatFromInt(deep - 1)), regime);
+    self.cost_count = 0;
+    for (1..k.rows + 1) |w| {
+        self.costs[self.cost_count] = .{ .width = @intCast(w), .ms = k.verify[w] };
+        self.cost_count += 1;
+    }
+    self.mtp_ms = k.level;
+
+    // shared rounds: n streams' full windows in one pass, and their draws
+    self.shared_count = 0;
+    for ([_]usize{ 2, 4 }) |n| {
+        for (&times) |*x| x.* = try shared(ops, e, io, probes[0..n], &ids, top, self.logits.ptr, &out);
+        self.shared[self.shared_count] = .{ .width = @intCast(n * top), .ms = median(times[1..]) };
+        self.shared_count += 1;
+    }
+    std.log.info("flashnext costs ({d:.1} s): windows 1..{d} {any} ms, a head level {d:.2} ms, shared {d} rows {d:.1} ms, {d} rows {d:.1} ms", .{
+        @as(f64, @floatFromInt(now(io) - t_all)) / 1e9, top, verify[1 .. top + 1], self.mtp_ms,
+        self.shared[0].width, self.shared[0].ms, self.shared[1].width, self.shared[1].ms,
+    });
+}
+
+/// One w-row window on p's stream from its next ids: the timed pass and draws, then one row kept (outside the time).
+fn window(ops: anytype, e: anytype, io: std.Io, p: *Probe, ids: []const u32, w: usize, out: *[mtp.max_rows]u32) !f64 {
+    const at = p.seq.fed;
+    try e.complete();
+    const t0 = now(io);
+    try ops.verify(&p.seq, &p.d, ids[at..][0..w]);
+    try ops.draws(&p.d, null, &.{}, out[0..w]);
+    const ms = @as(f64, @floatFromInt(now(io) - t0)) / 1e6;
+    try ops.rollback(&p.seq, &p.d, 1);
+    return ms;
+}
+
+/// The probes' w-row windows in one shared pass: the timed pass and every stream's draws, then one row kept each.
+fn shared(ops: anytype, e: anytype, io: std.Io, ps: []Probe, ids: []const u32, w: usize, logits: u64, out: *[mtp.max_rows]u32) !f64 {
+    var seqs: [4]*@import("cuda_prompt.zig").Seq = undefined;
+    var ds: [4]*mtp.Draft = undefined;
+    var idss: [4][]const u32 = undefined;
+    for (ps, 0..) |*p, i| {
+        seqs[i] = &p.seq;
+        ds[i] = &p.d;
+        idss[i] = ids[p.seq.fed..][0..w];
+    }
+    try e.complete();
+    const t0 = now(io);
+    try ops.verifyMany(seqs[0..ps.len], ds[0..ps.len], idss[0..ps.len], logits);
+    for (ds[0..ps.len]) |d| try ops.draws(d, null, &.{}, out[0..w]);
+    const ms = @as(f64, @floatFromInt(now(io) - t0)) / 1e6;
+    for (ps) |*p| try ops.rollback(&p.seq, &p.d, 1);
+    return ms;
+}
