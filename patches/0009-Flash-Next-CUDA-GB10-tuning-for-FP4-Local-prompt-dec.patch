diff --git a/zig/src/families/flashnext/cuda_kv8.zig b/zig/src/families/flashnext/cuda_kv8.zig
new file mode 100644
index 00000000..952cbe37
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_kv8.zig
@@ -0,0 +1,65 @@
+//! TF_FLASHNEXT_KV=fp8: the attention caches as e4m3 rows, one power-of-two scale a (position, KV head) row, the
+//! zig-flashnext engine's format (its kv8.py) byte for byte; bf16 (the default) keeps them as before.
+//!   keys   [cap, kv_heads, head_dim + 16]: the codes, then s_k, s_v (fp32) and 8 zero bytes;
+//!   values [cap, kv_heads, head_dim]:      the codes (their scale is in the key row's trailer).
+//! A row's bytes depend on its bf16 row alone (fn_attn_prep8 writes prompt and decode rows alike) and the readers widen
+//! codes times scale to bf16 exactly, so concurrent == alone, drafted == undrafted and restored == fresh still hold.
+//! Lossy against bf16 KV: replies differ.
+const std = @import("std");
+const wt = @import("cuda_prompt_wt.zig");
+
+/// Bytes after a key row's codes: s_k, s_v, 8 zero bytes.
+pub const pad = 16;
+
+var cached: ?bool = null;
+var cached_head: ?bool = null;
+
+/// Read once; an unknown value is refused at load (check).
+pub fn on() bool {
+    if (cached) |c| return c;
+    const fp8 = if (std.c.getenv("TF_FLASHNEXT_KV")) |v| std.mem.eql(u8, std.mem.span(v), "fp8") else false;
+    cached = fp8;
+    return fp8;
+}
+
+/// The draft head's cache in FP8 too: only with TF_FLASHNEXT_KV=fp8 and TF_FLASHNEXT_KV_HEAD=fp8. By default it stays
+/// bf16: one layer, and FP8 there cost a fifth of the tokens a round (accept probe, build 14, 10-25).
+pub fn head() bool {
+    if (cached_head) |c| return c;
+    const fp8 = on() and if (std.c.getenv("TF_FLASHNEXT_KV_HEAD")) |v| std.mem.eql(u8, std.mem.span(v), "fp8") else false;
+    cached_head = fp8;
+    return fp8;
+}
+
+pub fn check() !void {
+    for ([_][*:0]const u8{ "TF_FLASHNEXT_KV", "TF_FLASHNEXT_KV_HEAD" }) |name| {
+        const v = std.mem.span(std.c.getenv(name) orelse continue);
+        if (!std.mem.eql(u8, v, "fp8") and !std.mem.eql(u8, v, "bf16")) return error.BadKvFormat;
+    }
+}
+
+/// One position's keys (all KV heads) in one attention layer, FP8 rows or bf16.
+pub fn keyRowBytesOf(fp8: bool) usize {
+    return if (fp8) wt.kv_heads * (wt.head_dim + pad) else wt.kv_heads * wt.head_dim * 2;
+}
+
+/// One position's values (all KV heads) in one attention layer, FP8 rows or bf16.
+pub fn valueRowBytesOf(fp8: bool) usize {
+    return if (fp8) wt.kv_heads * wt.head_dim else wt.kv_heads * wt.head_dim * 2;
+}
+
+/// The model's caches.
+pub fn keyRowBytes() usize {
+    return keyRowBytesOf(on());
+}
+
+pub fn valueRowBytes() usize {
+    return valueRowBytesOf(on());
+}
+
+test "fp8 rows are the zig-flashnext engine's 272 + 256 bytes a KV head" {
+    cached = true;
+    defer cached = null;
+    try std.testing.expectEqual(wt.kv_heads * 272, keyRowBytes());
+    try std.testing.expectEqual(wt.kv_heads * 256, valueRowBytes());
+}
