+namespace fn_mtp {
+// A bf16 value's order as an unsigned key (larger value, larger key); -0 as +0, so equal values tie as drawRow's do.
+static __device__ __forceinline__ unsigned int order_key(unsigned short u) {
+    if (u == 0x8000u) u = 0;
+    return (u & 0x8000u) ? (~u & 0xFFFFu) : (u | 0x8000u);
+}
+}  // namespace fn_mtp
+
+// Program (row), 1024 threads: the K (<= V) best of a row's first V values as drawRow ranks them, every value above the
+// K-th and then the lowest columns among those equal to it: the K-th found on two byte histograms of the order keys.
+// out_v [rows, K] their bf16 bits, out_c [rows, K] their columns, unordered (sampling.choose sorts its candidates).
+extern "C" __global__ void __launch_bounds__(1024) fn_row_topk(const __nv_bfloat16* __restrict__ L, int V, long long ld,
+                                                               int K, unsigned short* __restrict__ out_v,
+                                                               int* __restrict__ out_c) {
+    using namespace fn_mtp;
+    const int r = blockIdx.x, t = threadIdx.x, nt = blockDim.x;
+    const unsigned short* row = reinterpret_cast<const unsigned short*>(L + static_cast<long long>(r) * ld);
+    unsigned short* ov = out_v + static_cast<long long>(r) * K;
+    int* oc = out_c + static_cast<long long>(r) * K;
+    __shared__ unsigned int hist[256];
+    __shared__ unsigned int scan[1024];
+    __shared__ unsigned int pick_hi, pick_lo, above, taken;
+    for (int i = t; i < 256; i += nt) hist[i] = 0;
+    __syncthreads();
+    for (int i = t; i < V; i += nt) atomicAdd(&hist[order_key(row[i]) >> 8], 1u);
+    __syncthreads();
+    if (t == 0) {
+        unsigned int cum = 0;
+        int b = 255;
+        for (; b > 0; --b) {
+            if (cum + hist[b] >= static_cast<unsigned int>(K)) break;
+            cum += hist[b];
+        }
+        pick_hi = b;
+        above = cum;
+    }
+    __syncthreads();
+    const unsigned int hi = pick_hi;
+    for (int i = t; i < 256; i += nt) hist[i] = 0;
+    __syncthreads();
+    for (int i = t; i < V; i += nt) {
+        const unsigned int k = order_key(row[i]);
+        if ((k >> 8) == hi) atomicAdd(&hist[k & 255u], 1u);
+    }
+    __syncthreads();
+    if (t == 0) {
+        unsigned int cum = above;
+        int b = 255;
+        for (; b > 0; --b) {
+            if (cum + hist[b] >= static_cast<unsigned int>(K)) break;
+            cum += hist[b];
+        }
+        pick_lo = b;
+        above = cum;
+        taken = 0;
+    }
+    __syncthreads();
+    const unsigned int kth = (hi << 8) | pick_lo, high = above, need = K - high;
+    // every value above the K-th, in any slot of the first `high`
+    for (int i = t; i < V; i += nt) {
+        if (order_key(row[i]) > kth) {
+            const unsigned int at = atomicAdd(&taken, 1u);
+            ov[at] = row[i];
+            oc[at] = i;
+        }
+    }
+    // the values equal to it: a thread's contiguous columns, its count scanned in thread order, the first `need` kept
+    const int per = (V + nt - 1) / nt, lo = t * per, end = min(V, lo + per);
+    unsigned int c = 0;
+    for (int i = lo; i < end; ++i) c += order_key(row[i]) == kth;
+    scan[t] = c;
+    __syncthreads();
+    if (t == 0) {
+        unsigned int s = 0;
+        for (int i = 0; i < nt; ++i) {
+            const unsigned int x = scan[i];
+            scan[i] = s;
+            s += x;
+        }
+    }
+    __syncthreads();
+    unsigned int rank = scan[t];
+    for (int i = lo; i < end && rank < need; ++i) {
+        if (order_key(row[i]) == kth) {
+            ov[high + rank] = row[i];
+            oc[high + rank] = i;
+            ++rank;
+        }
+    }
+}
