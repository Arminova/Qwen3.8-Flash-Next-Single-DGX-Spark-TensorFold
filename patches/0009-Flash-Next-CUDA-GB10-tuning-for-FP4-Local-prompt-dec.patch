+/// The smallest power of two 2^e with amax / 2^e <= 448, E4M3's largest finite value, so no code saturates.
+pub fn mxScaleExponent(amax: f32) i32 {
+    const biased: i32 = @intCast(@as(u32, @bitCast(amax)) >> 23);
